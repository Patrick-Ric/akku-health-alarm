    <string-array name="vendor_steps_xiaomi">
        <item>Engedélyezd az automatikus indítást az Akku Health Alarm számára.</item>
        <item>Beállítások → Alkalmazások → Akku Health Alarm → Energiatakarékosság: „Nincs korlátozás”.</item>
        <item>A legutóbbi alkalmazások nézetben tartsd nyomva az alkalmazást, és koppints a lakatra.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Telefonkezelő → Alkalmazásindítás: állítsd az Akku Health Alarmot „Kézi kezelés” módra, és kapcsold be mindhárom kapcsolót.</item>
        <item>Régebbi telefonok: Telefonkezelő → „Tisztítás zárolt képernyőn” vagy „Védett alkalmazások”: ne engedd bezárni az Akku Health Alarmot.</item>
        <item>A legutóbbi alkalmazások nézetben húzd lefelé az alkalmazást, amíg meg nem jelenik egy lakat.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Beállítások → Akkumulátor → Háttérhasználati korlátok → „Soha nem alvó alkalmazások” → add hozzá az Akku Health Alarmot.</item>
        <item>A legutóbbi alkalmazások nézetben koppints az alkalmazás ikonjára, és válaszd az „Alkalmazás zárolása” lehetőséget.</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Beállítások → Alkalmazások → Akku Health Alarm → Akkumulátor: engedélyezd az automatikus indítást és a háttértevékenységet.</item>
        <item>Kapcsold ki a „Fagyasztás a háttérben” és a „Rendellenes alkalmazások optimalizálása” lehetőséget.</item>
        <item>Zárold az alkalmazást a legutóbbi alkalmazások nézetben.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Alkalmazáskezelő → Automatikus indítás: kapcsold be az Akku Health Alarmot.</item>
        <item>Beállítások → Akkumulátor → Magas háttérfogyasztás: engedélyezd az Akku Health Alarmot.</item>
        <item>Zárold az alkalmazást a legutóbbi alkalmazások nézetben.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Beállítások → Akkumulátor → Akkumulátor-optimalizálás: állítsd az Akku Health Alarmot „Nincs optimalizálás” értékre.</item>
        <item>Beállítások → Akkumulátor → kapcsold ki a speciális optimalizálást.</item>
        <item>Zárold az alkalmazást a legutóbbi alkalmazások nézetben.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Ha van „Automatikus indítás” beállítás: engedélyezd az Akku Health Alarm számára.</item>
        <item>Ha lehet, zárold az alkalmazást a legutóbbi alkalmazások nézetben.</item>
    </string-array>
