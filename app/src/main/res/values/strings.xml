    <string name="setup_vendor">%s phones need some more settings.</string>
    <string name="setup_vendor_show">Show</string>
    <string name="setup_vendor_done">Done</string>
    <string-array name="vendor_steps_xiaomi">
        <item>Allow autostart for Akku Health Alarm.</item>
        <item>Settings → Apps → Akku Health Alarm → Battery saver: "No restrictions".</item>
        <item>In the recent apps view, hold the app and tap the lock.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Phone Manager → App launch: set Akku Health Alarm to "Manage manually" and turn on all three switches.</item>
        <item>Older phones: Phone Manager → "Lock screen cleanup" or "Protected apps": do not let Akku Health Alarm be closed.</item>
        <item>In the recent apps view, pull the app down until a lock appears.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Settings → Battery → Background usage limits → "Never sleeping apps" → add Akku Health Alarm.</item>
        <item>In the recent apps view, tap the app icon and choose "Lock this app".</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Settings → Apps → Akku Health Alarm → Battery: allow autostart and background activity.</item>
        <item>Turn off "Freeze in background" and "Optimize abnormal apps".</item>
        <item>Lock the app in the recent apps view.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → App manager → Autostart: turn on Akku Health Alarm.</item>
        <item>Settings → Battery → High background power use: allow Akku Health Alarm.</item>
        <item>Lock the app in the recent apps view.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Settings → Battery → Battery optimization: set Akku Health Alarm to "Don't optimize".</item>
        <item>Settings → Battery → turn off Advanced optimization.</item>
        <item>Lock the app in the recent apps view.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>If there is an "Autostart" setting: allow it for Akku Health Alarm.</item>
        <item>If possible, lock the app in the recent apps view.</item>
    </string-array>
