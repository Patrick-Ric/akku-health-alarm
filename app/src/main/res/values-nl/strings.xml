    <string name="setup_vendor_done">Klaar</string>
    <string-array name="vendor_steps_xiaomi">
        <item>Sta automatisch starten toe voor Akku Health Alarm.</item>
        <item>Instellingen → Apps → Akku Health Alarm → Batterijbesparing: \"Geen beperkingen\".</item>
        <item>Houd in het overzicht van recente apps de app ingedrukt en tik op het slot.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Telefoonbeheer → App starten: zet Akku Health Alarm op \"Handmatig beheren\" en schakel alle drie de schakelaars in.</item>
        <item>Oudere telefoons: Telefoonbeheer → \"Opschonen bij vergrendeld scherm\" of \"Beschermde apps\": laat Akku Health Alarm niet sluiten.</item>
        <item>Trek in het overzicht van recente apps de app omlaag tot er een slot verschijnt.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Instellingen → Batterij → Limieten voor achtergrondgebruik → \"Apps die nooit slapen\" → voeg Akku Health Alarm toe.</item>
        <item>Tik in het overzicht van recente apps op het app-pictogram en kies \"Deze app vergrendelen\".</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Instellingen → Apps → Akku Health Alarm → Batterij: sta automatisch starten en achtergrondactiviteit toe.</item>
        <item>Schakel \"Bevriezen op de achtergrond\" en \"Abnormale apps optimaliseren\" uit.</item>
        <item>Vergrendel de app in het overzicht van recente apps.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → App-beheer → Automatisch starten: schakel Akku Health Alarm in.</item>
        <item>Instellingen → Batterij → Hoog stroomverbruik op de achtergrond: sta Akku Health Alarm toe.</item>
        <item>Vergrendel de app in het overzicht van recente apps.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Instellingen → Batterij → Batterijoptimalisatie: zet Akku Health Alarm op \"Niet optimaliseren\".</item>
        <item>Instellingen → Batterij → schakel geavanceerde optimalisatie uit.</item>
        <item>Vergrendel de app in het overzicht van recente apps.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Als er een instelling \"Automatisch starten\" is: sta die toe voor Akku Health Alarm.</item>
        <item>Vergrendel indien mogelijk de app in het overzicht van recente apps.</item>
    </string-array>
