    <string name="setup_vendor_done">Fatto</string>
    <string-array name="vendor_steps_xiaomi">
        <item>Consenti l\'avvio automatico di Akku Health Alarm.</item>
        <item>Impostazioni → App → Akku Health Alarm → Risparmio batteria: «Nessuna restrizione».</item>
        <item>Nella vista delle app recenti, tieni premuta l\'app e tocca il lucchetto.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Gestione telefono → Avvio app: imposta Akku Health Alarm su «Gestisci manualmente» e attiva tutti e tre gli interruttori.</item>
        <item>Telefoni più vecchi: Gestione telefono → «Pulizia a schermo bloccato» o «App protette»: non far chiudere Akku Health Alarm.</item>
        <item>Nella vista delle app recenti, trascina l\'app verso il basso finché appare un lucchetto.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Impostazioni → Batteria → Limiti di utilizzo in background → «App mai in sospensione» → aggiungi Akku Health Alarm.</item>
        <item>Nella vista delle app recenti, tocca l\'icona dell\'app e scegli «Blocca questa app».</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Impostazioni → App → Akku Health Alarm → Batteria: consenti l\'avvio automatico e l\'attività in background.</item>
        <item>Disattiva «Congela in background» e «Ottimizza app anomale».</item>
        <item>Blocca l\'app nella vista delle app recenti.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Gestione app → Avvio automatico: attiva Akku Health Alarm.</item>
        <item>Impostazioni → Batteria → Consumo elevato in background: consenti Akku Health Alarm.</item>
        <item>Blocca l\'app nella vista delle app recenti.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Impostazioni → Batteria → Ottimizzazione batteria: imposta Akku Health Alarm su «Non ottimizzare».</item>
        <item>Impostazioni → Batteria → disattiva l\'ottimizzazione avanzata.</item>
        <item>Blocca l\'app nella vista delle app recenti.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Se esiste l\'impostazione «Avvio automatico»: consentila per Akku Health Alarm.</item>
        <item>Se possibile, blocca l\'app nella vista delle app recenti.</item>
    </string-array>
