    <string name="setup_vendor_show">Afficher</string>
    <string name="setup_vendor_done">Fait</string>
    <string-array name="vendor_steps_xiaomi">
        <item>Autorisez le démarrage automatique pour Akku Health Alarm.</item>
        <item>Paramètres → Applications → Akku Health Alarm → Économiseur de batterie : « Aucune restriction ».</item>
        <item>Dans la vue des applications récentes, maintenez l\'application et touchez le cadenas.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Gestionnaire du téléphone → Lancement d\'applications : réglez Akku Health Alarm sur « Gérer manuellement » et activez les trois interrupteurs.</item>
        <item>Anciens téléphones : Gestionnaire du téléphone → « Nettoyage à l\'écran verrouillé » ou « Applications protégées » : ne laissez pas fermer Akku Health Alarm.</item>
        <item>Dans la vue des applications récentes, tirez l\'application vers le bas jusqu\'à ce qu\'un cadenas apparaisse.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Paramètres → Batterie → Limites d\'utilisation en arrière-plan → « Applications jamais en veille » → ajoutez Akku Health Alarm.</item>
        <item>Dans la vue des applications récentes, touchez l\'icône de l\'application et choisissez « Verrouiller cette application ».</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Paramètres → Applications → Akku Health Alarm → Batterie : autorisez le démarrage automatique et l\'activité en arrière-plan.</item>
        <item>Désactivez « Geler en arrière-plan » et « Optimiser les applications anormales ».</item>
        <item>Verrouillez l\'application dans la vue des applications récentes.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Gestionnaire d\'applications → Démarrage automatique : activez Akku Health Alarm.</item>
        <item>Paramètres → Batterie → Consommation élevée en arrière-plan : autorisez Akku Health Alarm.</item>
        <item>Verrouillez l\'application dans la vue des applications récentes.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Paramètres → Batterie → Optimisation de la batterie : réglez Akku Health Alarm sur « Ne pas optimiser ».</item>
        <item>Paramètres → Batterie → désactivez l\'optimisation avancée.</item>
        <item>Verrouillez l\'application dans la vue des applications récentes.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>S\'il existe un réglage « Démarrage automatique » : autorisez-le pour Akku Health Alarm.</item>
        <item>Si possible, verrouillez l\'application dans la vue des applications récentes.</item>
    </string-array>
