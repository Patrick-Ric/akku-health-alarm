    <string-array name="vendor_steps_xiaomi">
        <item>Tillat autostart for Akku Health Alarm.</item>
        <item>Innstillinger → Apper → Akku Health Alarm → Batterisparing: «Ingen begrensninger».</item>
        <item>Hold inne appen i oversikten over nylige apper, og trykk på låsen.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Telefonbehandler → Appstart: sett Akku Health Alarm til «Administrer manuelt» og slå på alle tre bryterne.</item>
        <item>Eldre telefoner: Telefonbehandler → «Opprydding ved låst skjerm» eller «Beskyttede apper»: ikke la Akku Health Alarm bli lukket.</item>
        <item>Dra appen ned i oversikten over nylige apper til det vises en lås.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Innstillinger → Batteri → Grenser for bakgrunnsbruk → «Apper som aldri sover» → legg til Akku Health Alarm.</item>
        <item>Trykk på appikonet i oversikten over nylige apper og velg «Lås denne appen».</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Innstillinger → Apper → Akku Health Alarm → Batteri: tillat autostart og bakgrunnsaktivitet.</item>
        <item>Slå av «Frys i bakgrunnen» og «Optimaliser unormale apper».</item>
        <item>Lås appen i oversikten over nylige apper.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Appbehandler → Autostart: slå på Akku Health Alarm.</item>
        <item>Innstillinger → Batteri → Høyt strømforbruk i bakgrunnen: tillat Akku Health Alarm.</item>
        <item>Lås appen i oversikten over nylige apper.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Innstillinger → Batteri → Batterioptimalisering: sett Akku Health Alarm til «Ikke optimaliser».</item>
        <item>Innstillinger → Batteri → slå av avansert optimalisering.</item>
        <item>Lås appen i oversikten over nylige apper.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Hvis det finnes en innstilling «Autostart»: tillat den for Akku Health Alarm.</item>
        <item>Lås om mulig appen i oversikten over nylige apper.</item>
    </string-array>
