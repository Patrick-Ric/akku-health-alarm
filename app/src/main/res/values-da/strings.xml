    <string-array name="vendor_steps_xiaomi">
        <item>Tillad autostart for Akku Health Alarm.</item>
        <item>Indstillinger → Apps → Akku Health Alarm → Batterisparer: \"Ingen begrænsninger\".</item>
        <item>Hold appen nede i oversigten over seneste apps, og tryk på låsen.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Telefonadministrator → Appstart: sæt Akku Health Alarm til \"Administrer manuelt\", og slå alle tre kontakter til.</item>
        <item>Ældre telefoner: Telefonadministrator → \"Oprydning ved låst skærm\" eller \"Beskyttede apps\": lad ikke Akku Health Alarm blive lukket.</item>
        <item>Træk appen ned i oversigten over seneste apps, indtil der vises en lås.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Indstillinger → Batteri → Grænser for baggrundsbrug → \"Apps, der aldrig sover\" → tilføj Akku Health Alarm.</item>
        <item>Tryk på appikonet i oversigten over seneste apps, og vælg \"Lås denne app\".</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Indstillinger → Apps → Akku Health Alarm → Batteri: tillad autostart og baggrundsaktivitet.</item>
        <item>Slå \"Frys i baggrunden\" og \"Optimer unormale apps\" fra.</item>
        <item>Lås appen i oversigten over seneste apps.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Appadministrator → Autostart: slå Akku Health Alarm til.</item>
        <item>Indstillinger → Batteri → Højt strømforbrug i baggrunden: tillad Akku Health Alarm.</item>
        <item>Lås appen i oversigten over seneste apps.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Indstillinger → Batteri → Batterioptimering: sæt Akku Health Alarm til \"Optimer ikke\".</item>
        <item>Indstillinger → Batteri → slå avanceret optimering fra.</item>
        <item>Lås appen i oversigten over seneste apps.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Hvis der findes en indstilling \"Autostart\": tillad den for Akku Health Alarm.</item>
        <item>Lås om muligt appen i oversigten over seneste apps.</item>
    </string-array>
