    <string-array name="vendor_steps_xiaomi">
        <item>Povol automatické spouštění pro Akku Health Alarm.</item>
        <item>Nastavení → Aplikace → Akku Health Alarm → Spořič baterie: „Bez omezení“.</item>
        <item>V přehledu posledních aplikací podrž aplikaci a klepni na zámek.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Správce telefonu → Spouštění aplikací: nastav Akku Health Alarm na „Spravovat ručně“ a zapni všechny tři přepínače.</item>
        <item>Starší telefony: Správce telefonu → „Čištění při zamčené obrazovce“ nebo „Chráněné aplikace“: nenech Akku Health Alarm zavírat.</item>
        <item>V přehledu posledních aplikací stáhni aplikaci dolů, dokud se neobjeví zámek.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Nastavení → Baterie → Limity používání na pozadí → „Nikdy neuspávané aplikace“ → přidej Akku Health Alarm.</item>
        <item>V přehledu posledních aplikací klepni na ikonu aplikace a zvol „Zamknout tuto aplikaci“.</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Nastavení → Aplikace → Akku Health Alarm → Baterie: povol automatické spouštění a činnost na pozadí.</item>
        <item>Vypni „Zmrazit na pozadí“ a „Optimalizovat neobvyklé aplikace“.</item>
        <item>Zamkni aplikaci v přehledu posledních aplikací.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Správce aplikací → Automatické spouštění: zapni Akku Health Alarm.</item>
        <item>Nastavení → Baterie → Vysoká spotřeba na pozadí: povol Akku Health Alarm.</item>
        <item>Zamkni aplikaci v přehledu posledních aplikací.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Nastavení → Baterie → Optimalizace baterie: nastav Akku Health Alarm na „Neoptimalizovat“.</item>
        <item>Nastavení → Baterie → vypni pokročilou optimalizaci.</item>
        <item>Zamkni aplikaci v přehledu posledních aplikací.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Pokud existuje nastavení „Automatické spouštění“: povol ho pro Akku Health Alarm.</item>
        <item>Pokud je to možné, zamkni aplikaci v přehledu posledních aplikací.</item>
    </string-array>
