    <string name="setup_vendor_show">Arată</string>
    <string name="setup_vendor_done">Gata</string>
    <string-array name="vendor_steps_xiaomi">
        <item>Permite pornirea automată pentru Akku Health Alarm.</item>
        <item>Setări → Aplicații → Akku Health Alarm → Economisire baterie: „Fără restricții”.</item>
        <item>În vizualizarea aplicațiilor recente, ține apăsat pe aplicație și atinge lacătul.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Manager telefon → Lansare aplicații: setează Akku Health Alarm pe „Gestionare manuală” și activează toate cele trei comutatoare.</item>
        <item>Telefoane mai vechi: Manager telefon → „Curățare la ecran blocat” sau „Aplicații protejate”: nu lăsa Akku Health Alarm să fie închisă.</item>
        <item>În vizualizarea aplicațiilor recente, trage aplicația în jos până apare un lacăt.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Setări → Baterie → Limite de utilizare în fundal → „Aplicații care nu intră niciodată în repaus” → adaugă Akku Health Alarm.</item>
        <item>În vizualizarea aplicațiilor recente, atinge pictograma aplicației și alege „Blochează aplicația”.</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Setări → Aplicații → Akku Health Alarm → Baterie: permite pornirea automată și activitatea în fundal.</item>
        <item>Dezactivează „Înghețare în fundal” și „Optimizare aplicații anormale”.</item>
        <item>Blochează aplicația în vizualizarea aplicațiilor recente.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Manager aplicații → Pornire automată: activează Akku Health Alarm.</item>
        <item>Setări → Baterie → Consum mare în fundal: permite Akku Health Alarm.</item>
        <item>Blochează aplicația în vizualizarea aplicațiilor recente.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Setări → Baterie → Optimizarea bateriei: setează Akku Health Alarm pe „Nu optimiza”.</item>
        <item>Setări → Baterie → dezactivează optimizarea avansată.</item>
        <item>Blochează aplicația în vizualizarea aplicațiilor recente.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Dacă există setarea „Pornire automată”: permite-o pentru Akku Health Alarm.</item>
        <item>Dacă se poate, blochează aplicația în vizualizarea aplicațiilor recente.</item>
    </string-array>
