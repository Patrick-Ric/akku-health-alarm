    <string-array name="vendor_steps_xiaomi">
        <item>Salli automaattinen käynnistys sovellukselle Akku Health Alarm.</item>
        <item>Asetukset → Sovellukset → Akku Health Alarm → Virransäästö: ”Ei rajoituksia”.</item>
        <item>Pidä sovellusta painettuna viimeisimpien sovellusten näkymässä ja napauta lukkoa.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Puhelimen hallinta → Sovellusten käynnistys: aseta Akku Health Alarm tilaan ”Hallitse manuaalisesti” ja ota kaikki kolme kytkintä käyttöön.</item>
        <item>Vanhemmat puhelimet: Puhelimen hallinta → ”Siivous lukitusnäytöllä” tai ”Suojatut sovellukset”: älä anna sulkea Akku Health Alarmia.</item>
        <item>Vedä sovellusta alas viimeisimpien sovellusten näkymässä, kunnes lukko tulee näkyviin.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Asetukset → Akku → Taustakäytön rajoitukset → ”Ei koskaan nukkuvat sovellukset” → lisää Akku Health Alarm.</item>
        <item>Napauta sovelluksen kuvaketta viimeisimpien sovellusten näkymässä ja valitse ”Lukitse tämä sovellus”.</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Asetukset → Sovellukset → Akku Health Alarm → Akku: salli automaattinen käynnistys ja taustatoiminta.</item>
        <item>Poista käytöstä ”Jäädytä taustalla” ja ”Optimoi poikkeavat sovellukset”.</item>
        <item>Lukitse sovellus viimeisimpien sovellusten näkymässä.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Sovellusten hallinta → Automaattinen käynnistys: ota Akku Health Alarm käyttöön.</item>
        <item>Asetukset → Akku → Suuri virrankulutus taustalla: salli Akku Health Alarm.</item>
        <item>Lukitse sovellus viimeisimpien sovellusten näkymässä.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Asetukset → Akku → Akun optimointi: aseta Akku Health Alarm tilaan ”Älä optimoi”.</item>
        <item>Asetukset → Akku → poista edistynyt optimointi käytöstä.</item>
        <item>Lukitse sovellus viimeisimpien sovellusten näkymässä.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Jos asetus ”Automaattinen käynnistys” on olemassa: salli se Akku Health Alarmille.</item>
        <item>Lukitse sovellus mahdollisuuksien mukaan viimeisimpien sovellusten näkymässä.</item>
    </string-array>
