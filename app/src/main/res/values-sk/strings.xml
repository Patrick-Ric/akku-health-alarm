    <string-array name="vendor_steps_xiaomi">
        <item>Povoľ automatické spúšťanie pre Akku Health Alarm.</item>
        <item>Nastavenia → Aplikácie → Akku Health Alarm → Šetrič batérie: „Bez obmedzení“.</item>
        <item>V prehľade posledných aplikácií podrž aplikáciu a ťukni na zámok.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Správca telefónu → Spúšťanie aplikácií: nastav Akku Health Alarm na „Spravovať ručne“ a zapni všetky tri prepínače.</item>
        <item>Staršie telefóny: Správca telefónu → „Čistenie pri zamknutej obrazovke“ alebo „Chránené aplikácie“: nenechaj Akku Health Alarm zatvárať.</item>
        <item>V prehľade posledných aplikácií stiahni aplikáciu nadol, kým sa neobjaví zámok.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Nastavenia → Batéria → Limity používania na pozadí → „Nikdy neuspávané aplikácie“ → pridaj Akku Health Alarm.</item>
        <item>V prehľade posledných aplikácií ťukni na ikonu aplikácie a zvoľ „Zamknúť túto aplikáciu“.</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Nastavenia → Aplikácie → Akku Health Alarm → Batéria: povoľ automatické spúšťanie a činnosť na pozadí.</item>
        <item>Vypni „Zmraziť na pozadí“ a „Optimalizovať neobvyklé aplikácie“.</item>
        <item>Zamkni aplikáciu v prehľade posledných aplikácií.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Správca aplikácií → Automatické spúšťanie: zapni Akku Health Alarm.</item>
        <item>Nastavenia → Batéria → Vysoká spotreba na pozadí: povoľ Akku Health Alarm.</item>
        <item>Zamkni aplikáciu v prehľade posledných aplikácií.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Nastavenia → Batéria → Optimalizácia batérie: nastav Akku Health Alarm na „Neoptimalizovať“.</item>
        <item>Nastavenia → Batéria → vypni pokročilú optimalizáciu.</item>
        <item>Zamkni aplikáciu v prehľade posledných aplikácií.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Ak existuje nastavenie „Automatické spúšťanie“: povoľ ho pre Akku Health Alarm.</item>
        <item>Ak je to možné, zamkni aplikáciu v prehľade posledných aplikácií.</item>
    </string-array>
