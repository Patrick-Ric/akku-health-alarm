    <string-array name="vendor_steps_xiaomi">
        <item>Akku Health Alarm için otomatik başlatmaya izin ver.</item>
        <item>Ayarlar → Uygulamalar → Akku Health Alarm → Pil tasarrufu: \"Kısıtlama yok\".</item>
        <item>Son uygulamalar görünümünde uygulamaya basılı tut ve kilide dokun.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Telefon Yöneticisi → Uygulama başlatma: Akku Health Alarm\'ı \"Manuel olarak yönet\" yap ve üç anahtarı da aç.</item>
        <item>Eski telefonlar: Telefon Yöneticisi → \"Kilit ekranında temizleme\" veya \"Korunan uygulamalar\": Akku Health Alarm\'ın kapatılmasına izin verme.</item>
        <item>Son uygulamalar görünümünde kilit görünene kadar uygulamayı aşağı çek.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Ayarlar → Pil → Arka plan kullanım sınırları → \"Hiç uyumayan uygulamalar\" → Akku Health Alarm\'ı ekle.</item>
        <item>Son uygulamalar görünümünde uygulama simgesine dokun ve \"Bu uygulamayı kilitle\"yi seç.</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Ayarlar → Uygulamalar → Akku Health Alarm → Pil: otomatik başlatmaya ve arka plan etkinliğine izin ver.</item>
        <item>\"Arka planda dondur\" ve \"Anormal uygulamaları optimize et\" seçeneklerini kapat.</item>
        <item>Uygulamayı son uygulamalar görünümünde kilitle.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Uygulama yöneticisi → Otomatik başlatma: Akku Health Alarm\'ı aç.</item>
        <item>Ayarlar → Pil → Yüksek arka plan güç kullanımı: Akku Health Alarm\'a izin ver.</item>
        <item>Uygulamayı son uygulamalar görünümünde kilitle.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Ayarlar → Pil → Pil optimizasyonu: Akku Health Alarm\'ı \"Optimize etme\" yap.</item>
        <item>Ayarlar → Pil → gelişmiş optimizasyonu kapat.</item>
        <item>Uygulamayı son uygulamalar görünümünde kilitle.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>\"Otomatik başlatma\" ayarı varsa: Akku Health Alarm için izin ver.</item>
        <item>Mümkünse uygulamayı son uygulamalar görünümünde kilitle.</item>
    </string-array>
