    <string name="setup_vendor_show">Ver</string>
    <string name="setup_vendor_done">Hecho</string>
    <string-array name="vendor_steps_xiaomi">
        <item>Permite el inicio automático de Akku Health Alarm.</item>
        <item>Ajustes → Aplicaciones → Akku Health Alarm → Ahorro de batería: «Sin restricciones».</item>
        <item>En la vista de apps recientes, mantén pulsada la app y toca el candado.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Gestor del teléfono → Inicio de aplicaciones: pon Akku Health Alarm en «Gestionar manualmente» y activa los tres interruptores.</item>
        <item>Teléfonos antiguos: Gestor del teléfono → «Limpieza con pantalla bloqueada» o «Aplicaciones protegidas»: no dejes que se cierre Akku Health Alarm.</item>
        <item>En la vista de apps recientes, arrastra la app hacia abajo hasta que aparezca un candado.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Ajustes → Batería → Límites de uso en segundo plano → «Aplicaciones que nunca entran en suspensión» → añade Akku Health Alarm.</item>
        <item>En la vista de apps recientes, toca el icono de la app y elige «Bloquear esta app».</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Ajustes → Aplicaciones → Akku Health Alarm → Batería: permite el inicio automático y la actividad en segundo plano.</item>
        <item>Desactiva «Congelar en segundo plano» y «Optimizar apps anómalas».</item>
        <item>Bloquea la app en la vista de apps recientes.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Gestor de aplicaciones → Inicio automático: activa Akku Health Alarm.</item>
        <item>Ajustes → Batería → Alto consumo en segundo plano: permite Akku Health Alarm.</item>
        <item>Bloquea la app en la vista de apps recientes.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Ajustes → Batería → Optimización de batería: pon Akku Health Alarm en «No optimizar».</item>
        <item>Ajustes → Batería → desactiva la optimización avanzada.</item>
        <item>Bloquea la app en la vista de apps recientes.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Si existe el ajuste «Inicio automático»: permítelo para Akku Health Alarm.</item>
        <item>Si es posible, bloquea la app en la vista de apps recientes.</item>
    </string-array>
