    <string-array name="vendor_steps_xiaomi">
        <item>Tillåt autostart för Akku Health Alarm.</item>
        <item>Inställningar → Appar → Akku Health Alarm → Batterisparläge: ”Inga begränsningar”.</item>
        <item>I vyn för senaste appar, håll in appen och tryck på låset.</item>
    </string-array>
    <string-array name="vendor_steps_huawei">
        <item>Telefonhanteraren → Appstart: ställ in Akku Health Alarm på ”Hantera manuellt” och slå på alla tre reglagen.</item>
        <item>Äldre telefoner: Telefonhanteraren → ”Rensning vid låst skärm” eller ”Skyddade appar”: låt inte Akku Health Alarm stängas.</item>
        <item>I vyn för senaste appar, dra ned appen tills ett lås visas.</item>
    </string-array>
    <string-array name="vendor_steps_samsung">
        <item>Inställningar → Batteri → Gränser för bakgrundsanvändning → ”Appar som aldrig sover” → lägg till Akku Health Alarm.</item>
        <item>I vyn för senaste appar, tryck på appikonen och välj ”Lås den här appen”.</item>
    </string-array>
    <string-array name="vendor_steps_oppo">
        <item>Inställningar → Appar → Akku Health Alarm → Batteri: tillåt autostart och bakgrundsaktivitet.</item>
        <item>Stäng av ”Frys i bakgrunden” och ”Optimera avvikande appar”.</item>
        <item>Lås appen i vyn för senaste appar.</item>
    </string-array>
    <string-array name="vendor_steps_vivo">
        <item>i Manager → Apphanterare → Autostart: slå på Akku Health Alarm.</item>
        <item>Inställningar → Batteri → Hög strömförbrukning i bakgrunden: tillåt Akku Health Alarm.</item>
        <item>Lås appen i vyn för senaste appar.</item>
    </string-array>
    <string-array name="vendor_steps_oneplus">
        <item>Inställningar → Batteri → Batterioptimering: ställ in Akku Health Alarm på ”Optimera inte”.</item>
        <item>Inställningar → Batteri → stäng av avancerad optimering.</item>
        <item>Lås appen i vyn för senaste appar.</item>
    </string-array>
    <string-array name="vendor_steps_other">
        <item>Om det finns en inställning ”Autostart”: tillåt den för Akku Health Alarm.</item>
        <item>Om möjligt, lås appen i vyn för senaste appar.</item>
    </string-array>
